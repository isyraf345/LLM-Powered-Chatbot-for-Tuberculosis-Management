# Copy to .env in the project root and enter your newly rotated key privately.
# Existing terminal environment variables take precedence. Restart after editing.
OPENAI_API_KEY=

# Optional LangSmith tracing. Disabled unless explicitly true AND a key is set.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=tb-chatbot
# US default; EU: https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Explicit opt-in to exporting question/context/answer text. Public test data only.
TB_TRACE_CONTENT=false

# Local PostgreSQL: choose a URL-safe password, use the same value in DATABASE_URL.
POSTGRES_PASSWORD=
DATABASE_URL=
# Example URL: postgresql+psycopg://tb_app:YOUR_PASSWORD@127.0.0.1:5433/tb_chatbot
# Set true when serving over HTTPS. Local HTTP development uses false.
COOKIE_SECURE=false
